---
import User from "./icons/User.astro";
---

<section class="about-me" id="about">
    <h2 class="about-me-header">
        <User />
        About Me
    </h2>
    <article class="about-container">
        <div class="about">
            <p>
                Hi, I'm Karol Gonzalez Binczak, a Systems Administration and
                Networking student with a <span class="strong"
                    >strong passion for programming and automation.</span
                >
            </p>
            <p>
                <span class="strong"
                    >I enjoy creating scripts, web tools, and automating
                    processes</span
                > to make IT tasks more efficient.
            </p>
            <p>
                <span class="strong"
                    >I am proactive, eager to learn, and committed to delivering
                    high-quality solutions.</span
                > In my free time, I explore new technologies, work on personal projects,
                and continuously improve my skills in scripting and IT automation.
            </p>
        </div>
        <img src="yo.webp" alt="Karol Gonzalez Binczak" class="me" />
    </article>
</section>

<style>
    .about-me {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 2rem;
        scroll-margin: 3rem;
        margin-bottom: 6rem;
    }
    .about-me-header {
        display: flex;
        align-items: center;
        font-size: xx-large;
        gap: 0.5rem;
    }
    .about-container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        align-items: center;
    }
    .about {
        max-width: 36rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        font-size: large;
        order: 1;
    }
    .me {
        max-width: 100%;
        object-fit: cover;
        width: 240px;
        height: 240px;
        border-radius: 1rem;
        transform: rotate(5deg);
    }
    .strong {
        color: rgba(236, 18, 18, 0.952);
    }
    @media screen and (min-width: 768px) {
        .about-container {
            flex-direction: row;
        }
        .about {
            order: 0;
        }
    }
</style>
